# Copy to .env.local and fill in. .env.local is gitignored.
# Secrets must NOT be prefixed NEXT_PUBLIC_ (that bundles them to the browser).

# ── Public (safe to ship to the browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only secrets ──
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_INBOX_EMAIL=
APPEALS_EMAIL=
CRON_SECRET=

# ── Rate limiting (Upstash) — optional; rate limiting is a no-op if unset ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile — optional; widget/verify skipped if unset ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Observability — optional; inert if unset ──
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
