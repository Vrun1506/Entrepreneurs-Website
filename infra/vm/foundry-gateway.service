[Unit]
Description=Foundry upload gateway
Documentation=https://github.com/icf-community/Entrepreneurs-Website/blob/main/server/README.md
After=network.target

[Service]
User=foundry
Group=foundry
WorkingDirectory=/opt/foundry/app
EnvironmentFile=/etc/foundry/gateway.env
ExecStart=/opt/foundry/venv/bin/gunicorn -c gunicorn.conf.py app.main:app
Restart=always
RestartSec=3

# The gateway decodes attacker-supplied images all day. These cost nothing
# and shrink what a decoder bug could reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute=true
#   Blocks a whole class of injected-shellcode attacks and is tempting for a
#   process that decodes hostile images. Left commented because it breaks
#   some Python C extensions that map W+X pages, and nothing here has been
#   run against it — turn it on deliberately, deploy, and let the health
#   check in infra/deploy.sh tell you within seconds whether it holds.
# It writes nothing to disk: images go straight to Blob and there is no
# database. PrivateTmp gives it a scratch /tmp if Pillow ever needs one.
ReadWritePaths=

[Install]
WantedBy=multi-user.target
