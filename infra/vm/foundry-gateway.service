[Unit]
Description=Foundry upload gateway
Documentation=https://github.com/icf-community/Entrepreneurs-Website/blob/main/server/README.md
After=network.target docker.service
Requires=docker.service

[Service]
EnvironmentFile=/etc/foundry/gateway.env
Environment=GATEWAY_IMAGE=ghcr.io/icf-community/foundry-gateway:latest

# --network host, not a published port: this VM runs nothing but this one
# container, so there's no other listener on the docker bridge to isolate
# it from, and host networking keeps the container sharing the VM's real
# loopback with nginx unchanged. That matters because gunicorn.conf.py
# trusts X-Forwarded-For only from 127.0.0.1 (nginx) — with the default
# bridge network + published port, the proxied connection would arrive from
# the docker bridge gateway instead, silently breaking that trust check.
# gunicorn still binds 127.0.0.1:8000 exactly as it did bare-metal, so
# nothing outside this VM's own loopback can reach it either way.
#
# Runs as root: Docker is now the privilege boundary, not systemd User=.
# The sandboxing this unit used to apply directly to the gunicorn process
# (NoNewPrivileges, ProtectSystem=strict, PrivateTmp, RestrictSUIDSGID,
# etc.) would be decorative here — it'd restrict the `docker` CLI call, not
# the containerized workload. The equivalent protections now live on the
# container itself: non-root USER in server/Dockerfile, plus
# --read-only/--cap-drop=ALL/--security-opt=no-new-privileges/--tmpfs
# below.
# The image is private — org policy blocks making it public even for an
# Owner account, so this VM authenticates its own pulls with a scoped
# read:packages token instead. See infra/vm/bootstrap.sh's GHCR pull
# credential section for how /etc/foundry/ghcr-pull.env gets there.
ExecStartPre=/bin/sh -c '. /etc/foundry/ghcr-pull.env && echo "$GHCR_TOKEN" | /usr/bin/docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin'
ExecStartPre=/usr/bin/docker pull ${GATEWAY_IMAGE}
ExecStartPre=-/usr/bin/docker rm -f foundry-gateway
ExecStart=/usr/bin/docker run --rm --name foundry-gateway \
  --network host \
  --env-file /etc/foundry/gateway.env \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  --cap-drop=ALL --security-opt=no-new-privileges \
  --memory=512m --pids-limit=256 \
  ${GATEWAY_IMAGE}
# -t 35: gunicorn.conf.py's graceful_timeout is 30s (workers get that long
# to finish an in-flight upload after SIGTERM before gunicorn itself force-
# kills them). `docker stop` SIGKILLs the whole container after its own
# timeout regardless of what's happening inside, so this has to exceed 30s
# or a deploy could cut off an in-flight upload that gunicorn itself would
# have let finish. systemd's own default TimeoutStopSec (90s) has headroom
# above this, so it never adds a second ceiling.
ExecStop=/usr/bin/docker stop -t 35 foundry-gateway
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
